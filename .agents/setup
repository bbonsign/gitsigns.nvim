#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$HOME/.local/bin:$PATH"

run_step() {
  local name="$1"
  shift
  echo "==> $name"
  local started=$SECONDS
  "$@"
  echo "<== $name ($((SECONDS - started))s)"
}

apt_install_missing() {
  local packages=()
  local package
  for package in "$@"; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'install ok installed'; then
      packages+=("$package")
    fi
  done

  if ((${#packages[@]})); then
    if [ "$(id -u)" -eq 0 ]; then
      apt-get update
      apt-get install -y "${packages[@]}"
    else
      sudo -n apt-get update
      sudo -n apt-get install -y "${packages[@]}"
    fi
  else
    echo 'All required system packages are already installed.'
  fi
}

ensure_profile_path() {
  local marker='# gitsigns.nvim orb toolchain'
  local profile="$HOME/.bash_profile"
  touch "$profile"
  if ! grep -Fqx "$marker" "$profile" 2>/dev/null; then
    cat >> "$profile" <<'EOF'

# gitsigns.nvim orb toolchain
case ":${PATH:-}:" in
  *:"$HOME/.local/bin":*) ;;
  *) export PATH="$HOME/.local/bin:${PATH:-}" ;;
esac
EOF
  fi
}

run_step 'Install system prerequisites' apt_install_missing \
  ca-certificates curl git make unzip wget tar python3 python3-venv luarocks

install_jj() {
  local architecture
  case "$(uname -m)" in
    x86_64) architecture='x86_64' ;;
    aarch64|arm64) architecture='aarch64' ;;
    *) echo "Unsupported architecture for the Jujutsu release: $(uname -m)" >&2; return 1 ;;
  esac

  local version='v0.44.0' asset archive_dir
  asset="jj-${version}-${architecture}-unknown-linux-musl.tar.gz"
  archive_dir="$(mktemp -d)"
  curl -fsSL "https://github.com/jj-vcs/jj/releases/download/${version}/${asset}" \
    | tar -xzf - -C "$archive_dir"
  install -m 0755 "$archive_dir/jj" "$HOME/.local/bin/jj"
  rm -rf "$archive_dir"
}

if ! command -v jj >/dev/null 2>&1; then
  run_step 'Install Jujutsu (jj)' install_jj
else
  echo "Jujutsu already installed: $(jj --version)"
fi

ensure_profile_path

# These are the repository's pinned, self-contained test and development tools.
# Keep project downloads in deps/ so a restored orb can reuse them.
run_step 'Install nvim-test, StyLua, and EmmyLua' make -C "$repo_root" nvim-test stylua emmylua

echo 'Orb setup complete.'
